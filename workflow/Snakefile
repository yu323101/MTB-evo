# MTB-Evo Snakemake Pipeline
# 结核杆菌进化分析流程

import os
from pathlib import Path

# 加载配置文件
configfile: "config.yaml"

# 获取样本列表
SAMPLES = config.get("samples", [])
if not SAMPLES:
    # 尝试从samples.txt读取
    if Path("samples.txt").exists():
        with open("samples.txt") as f:
            SAMPLES = [line.strip() for line in f if line.strip()]

if not SAMPLES:
    raise ValueError("No samples found. Please define samples in config.yaml or create samples.txt")

# 参数设置
DEPTH = config.get("depth", 10)
THRESHOLD = config.get("threshold", 5)
REFERENCE = config.get("reference", {})

# 输出目录
OUTDIR = Path(config.get("output_dir", "results"))

# 最终目标
rule all:
    input:
        f"{OUTDIR}/pair.txt",
        f"{OUTDIR}/test.tree"

# ============================================================================
# Step 1: 生成SNP calling脚本
# ============================================================================
rule step1_generate_script:
    input:
        list="samples.txt"
    output:
        f"{OUTDIR}/pair_end.sh"
    params:
        script=config.get("scripts", {}).get("pair_fixed_nostrandbias", "scripts/pair_fixed_nostrandbias.py")
    shell:
        """
        python3 {params.script} {input.list}
        mv pair_end.sh {output}
        """

# ============================================================================
# Step 2: SNP calling (外部工具)
# 注意：此步骤耗时较长，建议手动运行或使用集群提交
# ============================================================================
rule step2_snp_calling:
    input:
        script=f"{OUTDIR}/pair_end.sh"
    output:
        expand(f"{OUTDIR}/{{sample}}.snp", sample=SAMPLES),
        expand(f"{OUTDIR}/{{sample}}.cns", sample=SAMPLES)
    shell:
        """
        echo "========================================"
        echo "Step 2: SNP Calling"
        echo "========================================"
        echo ""
        echo "此步骤耗时较长，建议手动运行："
        echo "  cd {OUTDIR} && nohup bash pair_end.sh > pair_end.log 2>&1 &"
        echo ""
        echo "或使用集群提交："
        echo "  cd {OUTDIR} && sbatch pair_end.sh"
        echo ""
        echo "等待完成后，重新运行snakemake继续后续步骤。"
        echo ""
        echo "检查进度：tail -f {OUTDIR}/pair_end.log"
        echo "========================================"
        exit 1

# ============================================================================
# Step 3: 设置深度阈值
# ============================================================================
rule step3_depth:
    output:
        f"{OUTDIR}/depth.txt"
    params:
        depth=DEPTH
    shell:
        "echo {params.depth} > {output}"

# ============================================================================
# Step 4: 提取差异位点
# ============================================================================
rule step4_diff_loci:
    input:
        expand(f"{OUTDIR}/{{sample}}.snp", sample=SAMPLES)
    output:
        f"{OUTDIR}/diff_location.list"
    shell:
        "mtb-evo diff-loci --snp-dir {OUTDIR} --output {output}"

# ============================================================================
# Step 5-7: 基因型回溯 (为每个样本生成FAS文件)
# ============================================================================
rule step7_recall:
    input:
        loci=f"{OUTDIR}/diff_location.list",
        depth=f"{OUTDIR}/depth.txt",
        cns=f"{OUTDIR}/{{sample}}.cns"
    output:
        f"{OUTDIR}/{{sample}}.fas"
    shell:
        "mtb-evo recall --loci {input.loci} --depth {input.depth} "
        "--cns {input.cns} --output {output}"

# ============================================================================
# Step 8: 合并所有FAS文件
# ============================================================================
rule step8_merge:
    input:
        expand(f"{OUTDIR}/{{sample}}.fas", sample=SAMPLES)
    output:
        f"{OUTDIR}/all_strains.fa"
    shell:
        "mtb-evo merge --fas-dir {OUTDIR} --output {output}"

# ============================================================================
# Step 9: 提取祖先碱基
# ============================================================================
rule step9_wild_extract:
    input:
        loci=f"{OUTDIR}/diff_location.list",
        ancestor=REFERENCE.get("ancestor", "data/tb.ancestor.fasta")
    output:
        f"{OUTDIR}/wild_loci.list"
    shell:
        "mtb-evo wild-extract --loci {input.loci} "
        "--ancestor {input.ancestor} --output {output}"

# ============================================================================
# Step 10: 核心SNP过滤
# ============================================================================
rule step10_filter:
    input:
        wild=f"{OUTDIR}/wild_loci.list",
        alignment=f"{OUTDIR}/all_strains.fa"
    output:
        fa=f"{OUTDIR}/all_strains.fadel-InvMisF{THRESHOLD}.bak.fa",
        loc=f"{OUTDIR}/all_strains.fadel-InvMisF{THRESHOLD}.bak.loc"
    params:
        threshold=THRESHOLD,
        prefix=f"{OUTDIR}/all_strains"
    shell:
        "mtb-evo filter --wild-loci {input.wild} --alignment {input.alignment} "
        "--threshold {params.threshold} --output-prefix {params.prefix}"

# ============================================================================
# Step 11: SNP距离计算
# ============================================================================
rule step11_distance:
    input:
        f"{OUTDIR}/all_strains.fadel-InvMisF{THRESHOLD}.bak.fa"
    output:
        f"{OUTDIR}/pair.txt"
    shell:
        "mtb-evo distance --alignment {input} --output {output}"

# ============================================================================
# Step 12: 构建系统发育树
# ============================================================================
rule step12_tree:
    input:
        f"{OUTDIR}/all_strains.fadel-InvMisF{THRESHOLD}.bak.fa"
    output:
        f"{OUTDIR}/test.tree"
    params:
        fasttree=config.get("tools", {}).get("fasttree", "FastTree")
    shell:
        "{params.fasttree} -nt -gtr -boot 100 -fastest {input} > {output}"

# ============================================================================
# 辅助规则：检查依赖
# ============================================================================
rule check_dependencies:
    output:
        touch(f"{OUTDIR}/.deps_checked")
    run:
        import shutil
        
        tools = ["sickle", "bowtie2", "samtools", "java"]
        missing = []
        
        for tool in tools:
            if not shutil.which(tool):
                missing.append(tool)
        
        if missing:
            print(f"错误：缺少以下工具: {', '.join(missing)}")
            print("请运行: conda env create -f environment.yml")
            exit(1)
        
        varscan_jar = Path("scripts/VarScan.v2.3.9.jar")
        if not varscan_jar.exists():
            print("错误：找不到VarScan")
            print("请运行: bash scripts/download_varscan.sh")
            exit(1)
        
        print("✓ 所有依赖检查通过")
